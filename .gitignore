# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
/Ray Traced Audio/.utmp/
/Ray Traced Audio/[Ll]ibrary/
/Ray Traced Audio/[Tt]emp/
/Ray Traced Audio/[Oo]bj/
/Ray Traced Audio/[Bb]uild/
/Ray Traced Audio/[Bb]uilds/
/Ray Traced Audio/[Ll]ogs/
/Ray Traced Audio/[Uu]ser[Ss]ettings/

# MemoryCaptures can get excessive in size.
# They also could contain extremely sensitive data
/Ray Traced Audio/[Mm]emoryCaptures/

# Recordings can get excessive in size
/Ray Traced Audio/[Rr]ecordings/

# Uncomment this line if you wish to ignore the asset store tools plugin
# /[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
/Ray Traced Audio/[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio cache directory
/Ray Traced Audio/.vs/

# Gradle cache directory
/Ray Traced Audio/.gradle/

# Autogenerated VS/MD/Consulo solution and project files
/Ray Traced Audio/ExportedObj/
/Ray Traced Audio/.consulo/
/Ray Traced Audio/*.csproj
/Ray Traced Audio/*.unityproj
/Ray Traced Audio/*.sln
/Ray Traced Audio/*.suo
/Ray Traced Audio/*.tmp
/Ray Traced Audio/*.user
/Ray Traced Audio/*.userprefs
/Ray Traced Audio/*.pidb
/Ray Traced Audio/*.booproj
/Ray Traced Audio/*.svd
/Ray Traced Audio/*.pdb
/Ray Traced Audio/*.mdb
/Ray Traced Audio/*.opendb
/Ray Traced Audio/*.VC.db

# Unity3D generated meta files
/Ray Traced Audio/*.pidb.meta
/Ray Traced Audio/*.pdb.meta
/Ray Traced Audio/*.mdb.meta

# Unity3D generated file on crash reports
/Ray Traced Audio/sysinfo.txt

# Builds
/Ray Traced Audio/*.apk
/Ray Traced Audio/*.aab
/Ray Traced Audio/*.unitypackage
/Ray Traced Audio/*.unitypackage.meta
/Ray Traced Audio/*.app

# Crashlytics generated file
/Ray Traced Audio/crashlytics-build.properties

# Packed Addressables
/Ray Traced Audio/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
/Ray Traced Audio/[Aa]ssets/[Ss]treamingAssets/aa.meta
/Ray Traced Audio/[Aa]ssets/[Ss]treamingAssets/aa/*
